#!/bin/sh
# git-park: ramas estacionadas pendientes de entrar a la rama base, con notas por rama.
#
#   git park ...        lista manual de ramas estacionadas (estilo git stash list)
#   git park -t         lo mismo, con el estado de cada rama contra park.twinTargets
#   git memo ...   notas cortas ligadas a la rama donde se escribieron, o globales
#   --plain        salida estable separada por tabs, sin colores (para scripts)
#
# Portable: sh POSIX + git 2.38 o mayor. Corre igual en macOS, Linux y Git for Windows.
# No usa sed -i, date -j, find ni sort (en Windows los dos ultimos pueden resolver a
# los de System32). La salida es solo ASCII.
#
# Salida: "+" hecho, "-" quitado, "!" aviso, "x" error (a stderr).
#
# Configuracion con git config (global o por repo):
#   park.base          rama destino; por defecto la de origin/HEAD, luego main o master
#   park.remote        remoto (origin)
#   park.twinTargets   destinos que revisa park -t, separados por espacio (la rama base)
#   park.storyPattern  regex del ticket en el nombre de la rama, p.ej. 'sc-[0-9]+'
#                      (sin valor no se muestra la columna)
#   park.root          carpeta que contiene los repos, para --all (o variable PARK_ROOT)
#   park.staleDays     dias a partir de los cuales algo se marca como viejo (7)
#   park.color         auto | always | never (auto respeta NO_COLOR)
#
# Datos: texto plano en el directorio comun de git (compartido entre worktrees):
#   parked-branches    rama<TAB>fecha[<TAB>commit]   (commit: se estaciono sin commits
#                      propios y sigue ahi; mientras tanto no se limpia como "ya en la base")
#   memos              fecha<TAB>rama<TAB>texto   ("-" = sin rama; con fecha limite,
#                      el primer campo es creada@limite)
#   memos-trash        ultimas 50 notas borradas
#   locked-branches    ramas bloqueadas con git kit lock (aqui solo se muestran)
# Globales: ~/.memos y ~/.memos-trash

tab=$(printf '\t')
today=$(date +%Y-%m-%d)
gmemos="$HOME/.memos"
nested=
plain=

cfg() { git config --get "$1" 2>/dev/null; }

stale=$(cfg park.staleDays)
case "$stale" in ''|*[!0-9]*) stale=7 ;; esac
pattern=$(cfg park.storyPattern)
root=$(git config --type=path --get park.root 2>/dev/null)
root=${root:-$PARK_ROOT}

# colores y ancho: solo en terminal, salvo que park.color diga otra cosa; nada con --plain
bold= dim= cyan= green= yellow= red= reset= cols=0
setup_out() {
  [ -z "$plain" ] || return 0
  case "$(cfg park.color)" in
    always) usecolor=1 ;;
    never) usecolor= ;;
    *) usecolor=; [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && usecolor=1 ;;
  esac
  if [ -n "$usecolor" ]; then
    esc=$(printf '\033')
    bold="${esc}[1m"; dim="${esc}[2m"; cyan="${esc}[36m"
    green="${esc}[32m"; yellow="${esc}[33m"; red="${esc}[31m"; reset="${esc}[0m"
  fi
  # ancho de la terminal para recortar lineas largas; si no se sabe, no se recorta
  if [ -t 1 ]; then
    cols=${COLUMNS:-}
    [ -n "$cols" ] || cols=$(stty size 2>/dev/null </dev/tty | cut -d' ' -f2)
    [ -n "$cols" ] || cols=$(tput cols 2>/dev/null)
    case "$cols" in ''|*[!0-9]*) cols=0 ;; esac
  fi
}

# mensajes: + hecho, - quitado, ! aviso, x error. Con --plain, los avisos van a stderr
ok() { printf '%s\n' "$green+$reset $*"; }
removed() { if [ -n "$plain" ]; then echo "- $*" >&2; else printf '%s\n' "$dim- $*$reset"; fi; }
warn() { printf '%s\n' "$yellow!$reset $*"; }
diag() { printf '%s\n' "$yellow!$reset $*" >&2; }
die() { printf '%s\n' "${red}x$reset $*" >&2; exit 1; }
# aviso temporal en stderr mientras algo tarda (fetch); se borra con unbusy
busy_msg=
busy() { [ -z "$plain" ] && [ -t 2 ] || return 0; busy_msg=$*; printf '%s' "$dim$*$reset" >&2; }
unbusy() { [ -n "$busy_msg" ] || return 0; printf '\r%*s\r' "${#busy_msg}" '' >&2; busy_msg=; }

# funciones de awk compartidas: relleno, fechas (T = hoy), nombres de rama y recorte
awk_lib='
BEGIN { BYTES = (length("\303\261") == 2) }
function fill(s, w) { s = s ""; while (length(s) < w) s = s " "; return s }
function dnum(s,   y, m, d, era, yoe, doy) {
  if (s !~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/) return -1
  y = substr(s, 1, 4) + 0; m = substr(s, 6, 2) + 0; d = substr(s, 9, 2) + 0
  if (m <= 2) y--
  era = int(y / 400); yoe = y - era * 400
  doy = int((153 * (m > 2 ? m - 3 : m + 9) + 2) / 5) + d - 1
  return era * 146097 + yoe * 365 + int(yoe / 4) - int(yoe / 100) + doy
}
function age(s,   n) { n = dnum(s); return n < 0 ? "" : dnum(T) - n }
# antiguedad corta: hoy, 3d, 2sem, 5m, 1a
function rel(s,   a) {
  a = age(s); if (a == "") return ""
  if (a <= 0) return "hoy"
  if (a < 14) return a "d"
  if (a < 60) return int(a / 7) "sem"
  if (a < 730) return int(a / 30) "m"
  return int(a / 365) "a"
}
# rama con el prefijo tenue y el ultimo tramo resaltado: feature/sc-1/ + login
function bname(b,   p) {
  p = b; sub(/[^\/]*$/, "", p)
  return D p Z B C substr(b, length(p) + 1) Z
}
# largo visible (sin colores) y recorte a w columnas con "..."
function vlen(s) { gsub(/\033\[[0-9;]*m/, "", s); return length(s) }
function clip(s, w,   out, i, c, n, j) {
  if (w <= 0 || vlen(s) <= w) return s
  out = ""; n = 0
  for (i = 1; i <= length(s) && n < w - 3; i++) {
    c = substr(s, i, 1)
    if (c == "\033") { j = index(substr(s, i), "m"); out = out substr(s, i, j); i += j - 1; continue }
    out = out c; n++
  }
  # awk por bytes (mawk): no dejar un caracter UTF-8 partido
  if (BYTES) while (out != "" && substr(out, length(out), 1) >= "\200") out = substr(out, 1, length(out) - 1)
  return out "..." (index(s, "\033") ? "\033[0m" : "")
}
# inversa de dnum: numero de dia -> YYYY-MM-DD
function fromdays(z,   era, doe, yoe, y, doy, mp, d, m) {
  era = int(z / 146097); doe = z - era * 146097
  yoe = int((doe - int(doe / 1460) + int(doe / 36524) - int(doe / 146096)) / 365)
  y = yoe + era * 400; doy = doe - (365 * yoe + int(yoe / 4) - int(yoe / 100))
  mp = int((5 * doy + 2) / 153); d = doy - int((153 * mp + 2) / 5) + 1
  m = mp < 10 ? mp + 3 : mp - 9
  if (m <= 2) y++
  return sprintf("%04d-%02d-%02d", y, m, d)
}
# fecha limite: YYYY-MM-DD, +N (dias), hoy, manana o un dia de la semana (el proximo)
function parse_due(s,   t, wd, w, k) {
  s = tolower(s); t = dnum(T)
  if (dnum(s) >= 0) return s
  if (s ~ /^\+?[0-9]+d?$/) { gsub(/[^0-9]/, "", s); return fromdays(t + s) }
  if (s == "hoy" || s == "today") return T
  if (s ~ /^ma.+ana$/ || s == "tomorrow") return fromdays(t + 1)
  k = substr(s, 1, 3); w = -1
  if (k == "dom" || k == "sun") w = 0
  else if (k == "lun" || k == "mon") w = 1
  else if (k == "mar" || k == "tue") w = 2
  else if (substr(s, 1, 2) == "mi" || k == "wed") w = 3
  else if (k == "jue" || k == "thu") w = 4
  else if (k == "vie" || k == "fri") w = 5
  else if (substr(s, 1, 2) == "sa") w = 6
  if (w < 0) return ""
  wd = (t - dnum("2000-03-01") + 3) % 7      # 2000-03-01 fue miercoles; 0 = domingo
  k = (w - wd + 7) % 7; if (k == 0) k = 7
  return fromdays(t + k)
}
'

# ---------- utilidades de archivos (indices desde 0) ----------

count() { awk 'END { print NR }' "$1"; }
line_at() { awk -v n="$2" 'NR == n + 1' "$1"; }
del_line() { awk -v n="$2" 'NR != n + 1' "$1" > "$1.tmp" && mv "$1.tmp" "$1"; }
need_index() { case "$1" in ''|*[!0-9]*) die "falta el indice" ;; esac; }
# lee lineas por stdin y las manda a la papelera de $1, que guarda las ultimas 50
to_trash() {
  cat >> "$1-trash"
  tail -n 50 "$1-trash" > "$1-trash.tmp" && mv "$1-trash.tmp" "$1-trash"
}

# ---------- repo ----------

exists() { git show-ref -q --verify "refs/heads/$1"; }

in_repo() {
  dir=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
  parked="$dir/parked-branches"
  memos="$dir/memos"
  # migra la lista de cuando el comando se llamaba git pend
  if [ -f "$dir/pending-branches" ] && [ ! -f "$parked" ]; then mv "$dir/pending-branches" "$parked"; fi
  touch "$parked" "$memos"
  remote=$(cfg park.remote); remote=${remote:-origin}
  base=$(cfg park.base)
  if [ -z "$base" ]; then
    base=$(git symbolic-ref -q --short "refs/remotes/$remote/HEAD" 2>/dev/null)
    base=${base#"$remote"/}
    if [ -z "$base" ]; then
      if exists main; then base=main; elif exists master; then base=master; else base=main; fi
    fi
  fi
  # se compara contra la base local; si no existe, contra la de origin
  base_ref=$base
  if ! exists "$base" && git show-ref -q --verify "refs/remotes/$remote/$base"; then base_ref="$remote/$base"; fi
  targets=$(git config --get-all park.twinTargets 2>/dev/null | tr '\n' ' ')
  [ -n "${targets# }" ] || targets=$base
  return 0
}

# mergear la rama a la base no cambiaria nada (detecta tambien squash)
merged() {
  mt=$(git merge-tree --write-tree "$base_ref" "$1" 2>/dev/null) &&
    [ "$mt" = "$(git rev-parse "$base_ref^{tree}" 2>/dev/null)" ]
}

# la rama sigue en el commit con el que se estaciono sin commits propios ($2 = ese commit)
untouched() { [ -n "$2" ] && [ "$(git rev-parse -q --verify "refs/heads/$1")" = "$2" ]; }

notes() { awk -F'\t' -v b="$1" '$2 == b { n++ } END { print n + 0 }' "$memos"; }

show_notes() {
  awk -F'\t' -v b="$1" -v D="$dim" -v Z="$reset" -v COLS="$cols" -v T="$today" "$awk_lib"'
    $2 == b { t = $3; for (k = 4; k <= NF; k++) t = t "\t" $k
              print clip("  " D "#" (NR - 1) Z "  " t, COLS) }' "$memos"
}

# manda a la papelera todas las notas de una rama
drop_notes() {
  [ "$(notes "$1")" = 0 ] && return 0
  awk -F'\t' -v b="$1" '
    $2 == b { t = $3; for (k = 4; k <= NF; k++) t = t "\t" $k; print t }' "$memos" |
    while IFS= read -r t; do removed "  nota borrada: $t"; done
  awk -F'\t' -v b="$1" '$2 == b' "$memos" | to_trash "$memos"
  awk -F'\t' -v b="$1" '$2 != b' "$memos" > "$memos.tmp" && mv "$memos.tmp" "$memos"
  [ -n "$plain" ] || echo "  ${dim}(git memo undo para recuperar)$reset"
}

# quita notas y entradas de ramas borradas; sin "quick", tambien las ramas
# ya en la base que no tienen notas pendientes
clean() {
  gone=$(awk -F'\t' 'NF >= 2 && $2 != "-" && !seen[$2]++ { print $2 }' "$memos")
  if [ -n "$gone" ]; then
    printf '%s\n' "$gone" | while IFS= read -r b; do
      exists "$b" && continue
      removed "limpiada: notas de $b (ya no existe)"
      drop_notes "$b"
    done
  fi
  : > "$parked.tmp"
  while IFS="$tab" read -r b d p; do
    [ -n "$b" ] || continue
    if ! exists "$b"; then
      removed "limpiada: $b (ya no existe)"; continue
    fi
    # en cuanto la rama recibe commits deja de estar intacta
    untouched "$b" "$p" || p=
    if [ "$1" != quick ] && [ -z "$p" ] && [ "$(notes "$b")" = 0 ] && merged "$b"; then
      removed "limpiada: $b (ya en $base)"
    else
      printf '%s\t%s%s\n' "$b" "$d" "${p:+$tab$p}" >> "$parked.tmp"
    fi
  done < "$parked"
  mv "$parked.tmp" "$parked"
  # los bloqueos (git kit lock) de ramas que ya no existen se descartan
  if [ -s "$dir/locked-branches" ]; then
    : > "$dir/locked-branches.tmp"
    while IFS= read -r b; do
      if exists "$b"; then echo "$b" >> "$dir/locked-branches.tmp"; fi
    done < "$dir/locked-branches"
    mv "$dir/locked-branches.tmp" "$dir/locked-branches"
  fi
}

# ---------- park ----------

# repo, rama base y cuantas hay estacionadas
park_header() {
  [ -z "$plain" ] || return 0
  n=$(awk 'NF { n++ } END { print n + 0 }' "$parked")
  case "$n" in 0) w="sin ramas estacionadas" ;; 1) w="1 estacionada" ;; *) w="$n estacionadas" ;; esac
  name=$(git rev-parse --show-toplevel 2>/dev/null); name=${name##*/}
  echo "$bold${name:-repo}$reset  ${dim}base $base, $w$reset"
}

# una fila por rama: indice, antiguedad, [story] y, con -t, el estado contra cada destino,
# todo con ancho fijo; luego la rama y, entre parentesis, ya en <base>, N notas, etc.
# Con --plain: indice, rama, fecha, story, estado, notas, bloqueada y destino=estado
park_list() {
  [ -s "$parked" ] || return 0
  while IFS="$tab" read -r b d p; do
    [ -n "$b" ] || continue
    # m: 1 = ya en la base, 2 = todavia sin commits propios
    m=0
    if untouched "$b" "$p"; then m=2; elif merged "$b"; then m=1; fi
    # con -t: estado contra cada destino del remoto (y = ya entro, l = limpio, c = conflicto)
    tw=
    if [ -n "$twin" ]; then
      for t in $targets; do
        if ! git show-ref -q --verify "refs/remotes/$remote/$t"; then st=n
        elif tt=$(git merge-tree --write-tree "$remote/$t" "$b" 2>/dev/null); then
          if [ "$tt" = "$(git rev-parse "$remote/$t^{tree}")" ]; then st=y; else st=l; fi
        else st=c; fi
        tw="${tw:+$tw }$t:$st"
      done
    fi
    lk=0
    if [ -f "$dir/locked-branches" ] && grep -qxF -e "$b" "$dir/locked-branches"; then lk=1; fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$b" "$d" "$m" "$(notes "$b")" "$lk" "$tw"
  done < "$parked" | PARK_PATTERN="$pattern" awk -F'\t' -v T="$today" -v W="$stale" -v BASE="$base" \
    -v P="$plain" -v COLS="$cols" \
    -v B="$bold" -v D="$dim" -v C="$cyan" -v G="$green" -v Y="$yellow" -v R="$red" -v Z="$reset" "$awk_lib"'
    function add(s) { meta = meta (meta == "" ? "" : D ", " Z) s }
    function word(c) { return c == "y" ? "entro" : (c == "l" ? "limpio" : (c == "c" ? "conflicto" : "no existe")) }
    function tint(c) { return c == "y" ? G : (c == "l" ? D : (c == "c" ? R : Y)) }
    BEGIN { PT = ENVIRON["PARK_PATTERN"] }
    { br[NR] = $1; dt[NR] = $2; mg[NR] = $3; nt[NR] = $4; lk[NR] = $5; tw[NR] = $6
      s = ""; if (PT != "" && match($1, PT)) s = substr($1, RSTART, RLENGTH)
      st[NR] = s; if (length(s) > S) S = length(s) }
    END {
      I = length((NR - 1) "")
      for (i = 1; i <= NR; i++) {
        tn = split(tw[i], ts, " ")
        if (P != "") {
          line = (i - 1) "\t" br[i] "\t" dt[i] "\t" st[i] "\t" \
            (mg[i] == 1 ? "en-base" : (mg[i] == 2 ? "sin-commits" : "pendiente")) "\t" nt[i] "\t" lk[i]
          for (k = 1; k <= tn; k++) { split(ts[k], kv, ":"); w = word(kv[2]); sub(/ /, "-", w); line = line "\t" kv[1] "=" w }
          print line; continue
        }
        a = age(dt[i]); old = (a != "" && a >= W)
        line = "  " D fill(i - 1, I) Z "  " (old ? Y : D) fill(rel(dt[i]), 4) Z "  "
        if (S) line = line D fill(st[i] != "" ? "[" st[i] "]" : "", S + 2) Z "  "
        # cada destino ocupa lo mismo en todas las filas: "staging: conflicto"
        for (k = 1; k <= tn; k++) {
          split(ts[k], kv, ":")
          line = line D kv[1] ": " Z tint(kv[2]) fill(word(kv[2]), 9) Z "  "
        }
        line = line bname(br[i])
        meta = ""
        if (lk[i] == 1) add(Y "bloqueada" Z)
        if (mg[i] == 1) add(G "ya en " BASE Z)
        if (mg[i] == 2) add(D "sin commits" Z)
        if (nt[i] == 1) add(Y "1 nota" Z); else if (nt[i] > 1) add(Y nt[i] " notas" Z)
        print clip(line (meta == "" ? "" : "  " D "(" Z meta D ")" Z), COLS)
      }
    }'
}

global_count() {
  [ -s "$gmemos" ] || return 0
  awk 'NF { n++ } END { if (n == 1) print "1 nota global (memo -g)"
                        else if (n > 1) print n " notas globales (memo -g)" }' "$gmemos"
}

# tambien: N stashes, N notas globales, en una sola linea tenue
footer() {
  [ -z "$plain" ] || return 0
  s=$(git stash list | awk 'END { print NR }'); parts=
  if [ "$s" = 1 ]; then parts="1 stash"; elif [ "$s" -gt 1 ]; then parts="$s stashes"; fi
  if [ -z "$nested" ]; then
    g=$(global_count)
    [ -n "$g" ] && parts="${parts:+$parts, }$g"
  fi
  if [ -n "$parts" ]; then echo; echo "  ${dim}tambien: $parts$reset"; fi
}

pick() {
  need_index "$1"
  b=$(line_at "$parked" "$1" | cut -f1)
  [ -n "$b" ] || die "no hay indice $1"
}

go() { git switch "$b" || exit 1; show_notes "$b"; }

usage() {
  cat <<'EOF'
uso: git park [ls]            limpia y lista las ramas estacionadas
     git park -t              lo mismo, con el estado contra cada destino (park.twinTargets)
     git park N | go N        salta a la rama N y muestra sus notas
     git park add [rama]      estaciona la rama actual (o la indicada)
     git park rm N            la quita de la lista y manda sus notas a la papelera
     git park note N texto    anota en la rama N sin saltar a ella (acepta --due)
     git park --all           todos los repos bajo park.root

     git memo [ls]       lista las notas por rama (y debajo las globales)
     git memo texto...   anota en la rama actual
     git memo add texto  lo mismo, para notas que empiezan con un subcomando
     git memo --due <cuando> texto   con fecha limite: YYYY-MM-DD, +3, hoy, manana, viernes
     git memo .          solo las de la rama actual
     git memo rm N       manda la nota N a la papelera
     git memo trash      muestra la papelera
     git memo undo [N]   recupera la nota N de la papelera (sin N, la ultima)
     git memo edit       abre el archivo de notas en el editor
     git memo -g ...     lo mismo con las notas globales
     git memo --all      todos los repos bajo park.root

     --plain             en park, memo y sus listas: salida separada por tabs, sin colores

config: park.base, park.remote, park.twinTargets, park.storyPattern, park.root,
        park.staleDays, park.color
EOF
}

# ---------- memo ----------

current() {
  if [ -n "$forbranch" ]; then echo "$forbranch"; return 0; fi
  cb=
  [ -n "$scoped" ] && cb=$(git branch --show-current)
  echo "${cb:--}"
}

# $1 = archivo, $2 = rama para filtrar (opcional), $3 = no vacio para agrupar por rama,
# $4 = rama actual (su grupo va primero), $5 = sangria sin grupos ("  "). Indice real.
# Con --plain: indice, creada, limite, rama y texto
memo_list() {
  if [ ! -s "$1" ]; then [ -n "$plain" ] || echo "  $dim(sin notas)$reset"; return 0; fi
  awk -F'\t' -v only="$2" -v GR="$3" -v CUR="$4" -v T="$today" -v W="$stale" -v P="$plain" \
    -v IND="${5:-  }" -v COLS="$cols" -v B="$bold" -v C="$cyan" -v D="$dim" -v Y="$yellow" -v R="$red" -v Z="$reset" "$awk_lib"'
    function row(i, ind,   a, old, left, dm, hot, line) {
      a = age(dt[i]); old = (du[i] == "" && a != "" && a >= W); dm = ""; hot = old ? Y : D
      if (du[i] != "") {
        left = dnum(du[i]) - dnum(T)
        if (left < 0) { dm = R "vencio hace " (-left) (left == -1 ? " dia" : " dias") Z; hot = R }
        else if (left == 0) { dm = Y "vence hoy" Z; hot = Y }
        else if (left == 1) dm = "vence manana"
        else dm = D "vence " du[i] Z
      }
      line = ind D fill(ix[i], I) Z "  " hot fill(rel(dt[i]), 4) Z "  " tx[i] \
        (dm == "" ? "" : "  " D "(" Z dm D ")" Z)
      print clip(line, COLS)
    }
    NF == 0 { next }
    only != "" && $2 != only { next }
    { c++; ix[c] = (NR - 1) ""; split($1, p, "@"); dt[c] = p[1]; du[c] = p[2]; br[c] = $2
      t = $3; for (k = 4; k <= NF; k++) t = t "\t" $k
      tx[c] = t; if (length(ix[c]) > I) I = length(ix[c]) }
    END {
      if (P != "") { for (i = 1; i <= c; i++) print ix[i] "\t" dt[i] "\t" du[i] "\t" br[i] "\t" tx[i]; exit }
      if (!c) { print "  " D "(sin notas)" Z; exit }
      if (GR == "") { for (i = 1; i <= c; i++) row(i, IND); exit }
      # un grupo por rama: la actual primero, luego en el orden en que aparecen
      for (i = 1; i <= c; i++) if (br[i] == CUR) { ord[++ng] = CUR; seen[CUR] = 1; break }
      for (i = 1; i <= c; i++) if (!(br[i] in seen)) { seen[br[i]] = 1; ord[++ng] = br[i] }
      for (g = 1; g <= ng; g++) {
        h = ord[g] == "-" ? D "sin rama" Z : bname(ord[g])
        print clip("  " h (ord[g] == CUR ? "  " D "(actual)" Z : ""), COLS)
        for (i = 1; i <= c; i++) if (br[i] == ord[g]) row(i, "    ")
      }
    }' "$1"
}

# una nota es una linea: los saltos de linea se guardan como " / "
memo_add() {
  due=
  if [ "$1" = --due ]; then
    [ $# -ge 2 ] || die "uso: git memo --due <cuando> texto..."
    due=$(awk -v T="$today" -v s="$2" "$awk_lib"'BEGIN { print parse_due(s) }')
    [ -n "$due" ] || die "fecha no valida: $2 (usa YYYY-MM-DD, +N, hoy, manana o un dia de la semana)"
    shift 2
  fi
  text=$(printf '%s\n' "$*" | tr '\t' ' ' | tr -d '\r' | awk '
    { gsub(/^ +| +$/, "") }
    $0 != "" { printf "%s%s", (n++ ? " / " : ""), $0 }')
  [ -n "$text" ] || die "falta el texto"
  printf '%s\t%s\t%s\n' "$today${due:+@$due}" "$(current)" "$text" >> "$mfile"
  ok "anotada: $(($(count "$mfile") - 1))${due:+ (vence $due)}"
}

memo_main() {
  scoped= global=
  while :; do
    case "$1" in --plain) plain=1; shift ;; -g) global=1; shift ;; *) break ;; esac
  done
  case "$1" in ls|.|trash) if [ "$2" = --plain ]; then plain=1; fi ;; esac
  setup_out
  if [ "$1" = --all ]; then all memo; return 0; fi
  if [ -n "$global" ]; then mfile=$gmemos
  elif in_repo; then mfile=$memos; scoped=1
  else mfile=$gmemos; fi
  touch "$mfile" "$mfile-trash"
  case "$1" in
    ""|ls)
      cb=
      if [ -n "$scoped" ]; then clean quick; cb=$(git branch --show-current); fi
      memo_list "$mfile" "" "$scoped" "$cb"
      # dentro de un repo, las globales van debajo como recordatorio
      if [ -n "$scoped" ] && [ -z "$plain" ] && [ -s "$gmemos" ]; then
        echo; echo "  ${yellow}globales$reset"; memo_list "$gmemos" "" "" "" "    "
      fi ;;
    .)
      [ -n "$scoped" ] || die "memo . solo funciona dentro de un repo"
      clean quick; memo_list "$mfile" "$(current)" 1 "$(current)" ;;
    rm)
      need_index "$2"
      line=$(line_at "$mfile" "$2")
      [ -n "$line" ] || die "no hay indice $2"
      del_line "$mfile" "$2"
      printf '%s\n' "$line" | to_trash "$mfile"
      removed "borrada: $(printf '%s' "$line" | cut -f3-)" ;;
    trash)
      if [ ! -s "$mfile-trash" ]; then [ -n "$plain" ] || echo "  $dim(papelera vacia)$reset"; return 0; fi
      memo_list "$mfile-trash" "" "$scoped" "" ;;
    undo)
      [ -s "$mfile-trash" ] || die "la papelera esta vacia"
      n=${2:-$(($(count "$mfile-trash") - 1))}
      need_index "$n"
      line=$(line_at "$mfile-trash" "$n")
      [ -n "$line" ] || die "no hay indice $n"
      del_line "$mfile-trash" "$n"
      b=$(printf '%s' "$line" | cut -f2)
      t=$(printf '%s' "$line" | cut -f3-)
      # si la rama ya no existe, la nota vuelve sin rama para que la limpieza no la borre otra vez
      if [ -n "$scoped" ] && [ "$b" != - ] && ! exists "$b"; then
        line=$(printf '%s' "$line" | awk -F'\t' -v OFS='\t' '{ $2 = "-" } 1')
        ok "restaurada sin rama ($b ya no existe): $t"
      else
        ok "restaurada: $t"
      fi
      printf '%s\n' "$line" >> "$mfile"
      echo "  ${dim}indice: $(($(count "$mfile") - 1))$reset" ;;
    edit)
      ${VISUAL:-${EDITOR:-vi}} "$mfile" ;;
    add)
      shift; memo_add "$@" ;;
    *)
      memo_add "$@" ;;
  esac
  return 0
}

# ---------- --all ----------

# $1 = park | memo: recorre park.root y sus carpetas hijas
all() {
  [ -z "$plain" ] || die "--plain no funciona con --all"
  if [ -z "$root" ] || [ ! -d "$root" ]; then
    die "configura la carpeta de tus repos: git config --global park.root <ruta>"
  fi
  for d in "$root" "$root"/*/; do
    [ -d "$d/.git" ] || continue
    (
      cd "$d" && in_repo || exit 0
      if [ "$1" = memo ]; then f=$memos; else f=$parked; fi
      [ -s "$f" ] || exit 0
      echo
      nested=1
      if [ "$1" = memo ]; then
        clean quick; echo "$bold$(basename "$PWD")$reset"; memo_list "$memos" "" 1 ""
      else clean; park_header; park_list; footer; fi
    )
  done
  if [ "$1" = memo ]; then
    if [ -s "$gmemos" ]; then echo; echo "${yellow}globales$reset"; memo_list "$gmemos" "" "" ""; fi
  else
    g=$(global_count)
    if [ -n "$g" ]; then echo; echo "  ${dim}tambien: $g$reset"; fi
  fi
}

# ---------- entrada ----------

# git-memo (el envoltorio de al lado) entra por aqui; tambien sirve una copia con ese nombre
case "${0##*/}" in git-memo*) memo_main "$@"; exit 0 ;; esac
[ "$1" = memo ] && { shift; memo_main "$@"; exit 0; }

# -t y --plain van antes del subcomando, o despues de ls
twin=
while :; do
  case "$1" in -t) twin=1; shift ;; --plain) plain=1; shift ;; *) break ;; esac
done
if [ "$1" = ls ]; then
  shift
  for a in "$@"; do
    case "$a" in -t) twin=1 ;; --plain) plain=1 ;; *) usage >&2; exit 1 ;; esac
  done
  set -- ls
fi
setup_out

case "$1" in
  --all) all park; exit 0 ;;
  -h|--help|help) usage; exit 0 ;;
esac

in_repo || die "no estas dentro de un repo de git"
case "$1" in
  ""|ls)
    if [ -n "$twin" ]; then
      busy "buscando en $remote..."
      # shellcheck disable=SC2086
      git fetch -q "$remote" $targets 2>/dev/null; fetched=$?
      unbusy
      [ "$fetched" = 0 ] || diag "no se pudo hacer fetch, se compara contra lo ultimo descargado"
    fi
    clean; park_header; park_list; footer ;;
  note)
    pick "$2"; shift 2
    mfile=$memos; scoped=1; forbranch=$b
    memo_add "$@" ;;
  _clean)
    clean "$2" ;;
  add)
    b=${2:-$(git branch --show-current)}
    [ -n "$b" ] || die "no estas en una rama"
    exists "$b" || die "no existe la rama $b"
    if cut -f1 "$parked" | grep -qxF -e "$b"; then warn "ya estaba: $b"
    else
      # sin commits propios todavia: se guarda el commit para no limpiarla como "ya en la base"
      p=; merged "$b" && p=$(git rev-parse "refs/heads/$b")
      printf '%s\t%s%s\n' "$b" "$today" "${p:+$tab$p}" >> "$parked"; ok "estacionada: $b"
    fi ;;
  rm)
    pick "$2"; del_line "$parked" "$2"; removed "quitada: $b"; drop_notes "$b" ;;
  go)
    pick "$2"; go ;;
  *[!0-9]*)
    usage >&2; exit 1 ;;
  *)
    pick "$1"; go ;;
esac
exit 0
